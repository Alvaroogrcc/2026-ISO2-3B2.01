# --- Java / compilados -----------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
bin/
tmp/

# --- Visual Studio Code -----------------------------------------------------
# Se ignora el estado local del editor, pero se versionan las configuraciones
# compartidas por el equipo: extensiones recomendadas, ajustes de Java/Maven,
# configuración de depuración y tareas de construcción.
#
# Ojo: no puede escribirse `.vscode/` seguido de `!excepción`, porque Git no
# re-incluye un fichero cuyo directorio padre está excluido. Por eso se ignora
# el contenido (`*`) y no el directorio.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/.browse.data
.vscode/*.vscdb
.vscode/*.code-workspace

# --- Estado de IDE ajeno al oficial ----------------------------------------
# El IDE oficial es Visual Studio Code. Si algún miembro del equipo abre el
# proyecto con JetBrains, su configuración local no debe entrar al repositorio.
.idea/
*.iml
*.ipr
*.iws
nbproject/
nb-configuration.xml

# --- Visual Paradigm (herramienta de modelado) -----------------------------
# Los modelos .vpp son entregable de la wiki (README), así que se versionan.
# Solo se ignoran los temporales de trabajo y las copias de seguridad.
.vp_*
.vpworkspace
.vpbackup
*.vpd
*.vm.html
*.vpdata

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Editores y herramientas auxiliares ------------------------------------
*.swp
*.swo
*~
.atom/
.build/
.cxx/

# --- Logs y datos temporales de pruebas -------------------------------------
*.log
logs/
surefire-reports/
failsafe-reports/
/dumps/
/nul
